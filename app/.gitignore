# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.yalc
yarn.lock

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# local env files
.env*.local
.env

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
/scripts-ts-node/
# package-lock.json is deliberately NOT ignored. The starter kit ignored it,
# which meant a fresh clone had no lockfile — so `npm ci` refused to run at all
# ("can only install with an existing package-lock.json") and the Render build
# exited 1. Committing it is also the only way the deployed build matches what
# was tested here.
A1priv/A1priv.ts
/A1priv/

/target
.gstack/

# cairo build artifacts
/cairo/target/

# Deploy credentials — never commit
.env.deploy

.cursor/
.claude/
stitch/*